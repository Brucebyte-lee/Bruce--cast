# Copy to .env and adjust. Never commit the real .env file.
APP_ENV=development
LOG_LEVEL=INFO

# SQLite for local development. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/skycast
DATABASE_URL=sqlite:///./skycast.db

# Comma-separated list of allowed browser origins (only needed if the frontend is hosted elsewhere)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Open-Meteo (free tier is for non-commercial use; see README)
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# Only if you buy a commercial plan:
OPENMETEO_API_KEY=

RATE_LIMIT_PER_MINUTE=120
